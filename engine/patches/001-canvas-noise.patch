+// ─── FWYS Canvas noise namespace ──────────────────────────────────────────
+namespace fwys {
+  static uint64_t canvas_noise_seed = 0;
+  static bool noise_initialized = false;
+
+  void InitNoiseSeed(uint64_t seed) {
+    canvas_noise_seed = seed;
+    noise_initialized = (seed != 0);
+  }
+
+  bool IsNoiseEnabled() { return noise_initialized; }
+
+  // 3-round xorshift64 — same algorithm as JS counterpart for consistency
+  inline uint8_t NoiseByte(int x, int y, int channel) {
+    uint64_t h = canvas_noise_seed
+               ^ ((uint64_t)x * 2654435761ULL)
+               ^ ((uint64_t)y * 40503ULL)
+               ^ ((uint64_t)channel * 7919ULL);
+    h ^= h >> 33; h *= 0xff51afd7ed558ccdULL;
+    h ^= h >> 33; h *= 0xc4ceb9fe1a85ec53ULL;
+    h ^= h >> 33;
+    return (uint8_t)(h & 0x1);  // 1 LSB only — invisible noise
+  }
+
+  // Apply noise to a raw pixel buffer in-place
+  void ApplyNoiseToPixels(uint8_t* pixels, int width, int height) {
+    if (!noise_initialized || !pixels) return;
+    for (int y = 0; y < height; ++y) {
+      for (int x = 0; x < width; ++x) {
+        int idx = (y * width + x) * 4;
+        pixels[idx + 0] ^= NoiseByte(x, y, 0);  // R
+        pixels[idx + 1] ^= NoiseByte(x, y, 1);  // G
+        pixels[idx + 2] ^= NoiseByte(x, y, 2);  // B
+        // Alpha [idx+3] untouched — changing alpha breaks transparency
+      }
+    }
+  }
+} // namespace fwys

