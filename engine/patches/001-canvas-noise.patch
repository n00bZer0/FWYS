+namespace fwys {
+  static uint64_t canvas_noise_seed = 0;
+  void InitNoiseSeed(uint64_t seed) { canvas_noise_seed = seed; }
+  // Inject sub-pixel noise deterministically based on seed + pixel position
+  inline uint8_t NoiseByte(int x, int y, int channel) {
+    uint64_t h = canvas_noise_seed ^ ((uint64_t)x * 2654435761ULL)
+                 ^ ((uint64_t)y * 40503ULL) ^ ((uint64_t)channel * 7919ULL);
+    h ^= h >> 33; h *= 0xff51afd7ed558ccdULL;
+    h ^= h >> 33; h *= 0xc4ceb9fe1a85ec53ULL;
+    h ^= h >> 33;
+    // Returns 0 or 1 — sub-pixel level noise only
+    return (uint8_t)(h & 0x1);
+  }
