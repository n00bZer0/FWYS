 #include "third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.h"

+#include "base/command_line.h"
+#include "base/strings/utf_string_conversions.h"

+namespace fwys_webgl {
+  static std::string spoofed_vendor;
+  static std::string spoofed_renderer;
+  static bool initialized = false;
+
+  void EnsureInit() {
+    if (initialized) return;
+    initialized = true;
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd->HasSwitch("fwys-webgl-vendor")) {
+      spoofed_vendor = cmd->GetSwitchValueASCII("fwys-webgl-vendor");
+    }
+    if (cmd->HasSwitch("fwys-webgl-renderer")) {
+      spoofed_renderer = cmd->GetSwitchValueASCII("fwys-webgl-renderer");
+    }
+  }
+
+  const std::string& Vendor() { EnsureInit(); return spoofed_vendor; }
+  const std::string& Renderer() { EnsureInit(); return spoofed_renderer; }
+} // namespace fwys_webgl

