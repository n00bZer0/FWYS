+//
+// FWYS Patch 005 (v2 REWRITE): AudioContext fingerprint noise
+// PRIMARY target: OfflineAudioContext (used by ALL audio fingerprinters)
+// SECONDARY: RealtimeAnalyser getFloatFrequencyData / getByteFrequencyData

 #include "third_party/blink/renderer/modules/webaudio/offline_audio_destination_node.h"
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"

+// ─── FWYS Audio noise namespace ───────────────────────────────────────────────
+// Shared across: offline_audio_destination_node.cc, realtime_analyser.cc,
+//                audio_buffer.cc
+namespace fwys_audio {
+
+  static uint64_t audio_seed = 0;
+  static bool initialized    = false;
+
+  void EnsureInit() {
+    if (initialized) return;
+    initialized = true;
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd->HasSwitch("fwys-audio-seed")) {
+      base::StringToUint64(cmd->GetSwitchValueASCII("fwys-audio-seed"), &audio_seed);
+    }
+  }
+
+  bool IsEnabled() { EnsureInit(); return audio_seed != 0; }
+
+  // xorshift64* — fast, high-quality
+  inline uint64_t Hash(uint64_t seed, size_t index, int channel) {
+    uint64_t h = seed
+               ^ (uint64_t(index)   * 6364136223846793005ULL)
+               ^ (uint64_t(channel) * 2685821657736338717ULL)
+               ^ 1442695040888963407ULL;
+    h ^= h >> 33; h *= 0xff51afd7ed558ccdULL;
+    h ^= h >> 33; h *= 0xc4ceb9fe1a85ec53ULL;
+    h ^= h >> 33;
+    return h;
+  }
+
+  // Add ±1e-7 noise to a float audio sample — inaudible, defeats fingerprint
+  float NoiseSample(float sample, size_t index, int channel = 0) {
+    if (!IsEnabled()) return sample;
+    uint64_t h = Hash(audio_seed, index, channel);
+    // Map to [-1e-7, +1e-7]
+    float noise = ((float)(h & 0xFFFF) / (float)0xFFFF - 0.5f) * 2.0f * 1e-7f;
+    return sample + noise;
+  }
+
+  // Apply noise to an entire audio channel buffer in-place
+  void ApplyNoiseToBuffer(float* data, size_t length, int channel) {
+    if (!IsEnabled() || !data) return;
+    for (size_t i = 0; i < length; ++i) {
+      data[i] = NoiseSample(data[i], i, channel);
+    }
+  }
+
+} // namespace fwys_audio

 namespace blink {

@@ -85,6 +118,18 @@ void OfflineAudioDestinationHandler::StartRendering() {
   // ... existing start rendering ...
 }

+// ─── FWYS: Hook into Render() — the function that fills the output buffer ───
+// Every audio fingerprinter works like this:
+//   ctx = new OfflineAudioContext(1, 44100, 44100)
+//   oscillator → ctx.destination
+//   ctx.startRendering() → oncomplete → buffer data = fingerprint
+// We add noise AFTER Chromium renders to the buffer, BEFORE oncomplete fires.
 void OfflineAudioDestinationHandler::Render(
     uint32_t frames_to_process,
     base::TimeTicks audio_delay_timestamp,
     const media::AudioGlitchInfo& glitch_info) {
+
   // ... existing render logic ...
+
+  // FWYS: Inject noise into rendered output BEFORE returning to JS
+  // output_bus is the rendered buffer that JS reads via AudioBuffer.getChannelData()
+  if (fwys_audio::IsEnabled() && output_bus_) {
+    for (uint32_t ch = 0; ch < output_bus_->NumberOfChannels(); ++ch) {
+      float* data = output_bus_->MutableChannel(ch)->MutableData();
+      fwys_audio::ApplyNoiseToBuffer(data, output_bus_->length(), (int)ch);
+    }
+  }
 }

