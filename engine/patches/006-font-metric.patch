--- a/third_party/blink/renderer/platform/fonts/font.cc
+++ b/third_party/blink/renderer/platform/fonts/font.cc
@@ -1,5 +1,8 @@
 // Copyright 2003 The Chromium Authors
 // Use of this source code is governed by BSD-style license.
+//
+// FWYS Patch 006 (v2): Font metric noise — measureText + glyph bounds
+// Targets: Font::Width(), Font::FloatWidth(), TextMetrics, getBoundingClientRect on text

 #include "third_party/blink/renderer/platform/fonts/font.h"
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"

+// ─── FWYS Font metric namespace ───────────────────────────────────────────────
+// Used by: font.cc (Width/FloatWidth), font_metrics.cc (ascent/descent),
+//          canvas_rendering_context_2d.cc (measureText)
+namespace fwys_font {
+
+  static double metric_jitter = 0.0;   // ±jitter added to each metric
+  static double metric_scale  = 1.0;   // scale factor ≈ 1.0 ± tiny
+  static uint64_t font_seed   = 0;
+  static bool initialized     = false;
+
+  void EnsureInit() {
+    if (initialized) return;
+    initialized = true;
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd->HasSwitch("fwys-font-seed")) {
+      base::StringToUint64(cmd->GetSwitchValueASCII("fwys-font-seed"), &font_seed);
+    }
+    if (font_seed == 0) return;
+
+    // Derive scale factor: 1.0 ± 0.0001 (invisible but unique per profile)
+    uint64_t h = font_seed ^ 0xdeadbeefcafe1234ULL;
+    h ^= h >> 33; h *= 0xff51afd7ed558ccdULL; h ^= h >> 33;
+    double frac = (double)(h & 0xFFFF) / (double)0xFFFF;  // 0..1
+    metric_scale  = 1.0 + (frac - 0.5) * 0.0002; // [0.9999, 1.0001]
+
+    // Derive jitter: ±0.01px maximum
+    uint64_t h2 = h ^ 0x123456789abcdef0ULL;
+    h2 ^= h2 >> 33; h2 *= 0xc4ceb9fe1a85ec53ULL; h2 ^= h2 >> 33;
+    metric_jitter = ((double)(h2 & 0xFF) / (double)0xFF - 0.5) * 0.02; // [-0.01, +0.01]
+  }
+
+  bool IsEnabled() { EnsureInit(); return font_seed != 0; }
+
+  // Scale a width/advance value — different per profile, same within profile
+  float ScaleWidth(float value) {
+    if (!IsEnabled()) return value;
+    return (float)(value * metric_scale + metric_jitter);
+  }
+
+  // Scale a height metric (ascent, descent, leading) — smaller jitter
+  float ScaleHeight(float value) {
+    if (!IsEnabled()) return value;
+    return (float)(value * metric_scale + metric_jitter * 0.5f);
+  }
+
+  // Deterministic per-glyph noise for character-level measurements
+  // Different characters get different noise → defeats text-width fingerprinting
+  float GlyphNoise(UChar32 codepoint) {
+    if (!IsEnabled()) return 0.0f;
+    uint64_t h = font_seed ^ ((uint64_t)codepoint * 2654435761ULL);
+    h ^= h >> 33; h *= 0xff51afd7ed558ccdULL; h ^= h >> 33;
+    return ((float)(h & 0xFF) / (float)0xFF - 0.5f) * 0.005f; // ±0.0025px per glyph
+  }
+
+} // namespace fwys_font

