 // Copyright 2006 The Chromium Authors
+//
+// FWYS Patch 006d: Font list spoofing via font cache
+// Returns presence/absence of fonts based on profile --fwys-fonts-json list

 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"

+namespace fwys_fonts {
+  static std::set<std::string> allowed_fonts;
+  static bool restrict_fonts = false;
+  static bool initialized    = false;
+
+  void EnsureInit() {
+    if (initialized) return;
+    initialized = true;
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd->HasSwitch("fwys-fonts-json")) return;
+
+    std::string json_str = cmd->GetSwitchValueASCII("fwys-fonts-json");
+    // Parse ["Arial", "Times New Roman", ...]
+    auto value = base::JSONReader::Read(json_str);
+    if (!value || !value->is_list()) return;
+
+    restrict_fonts = true;
+    for (const auto& item : value->GetList()) {
+      if (item.is_string()) {
+        allowed_fonts.insert(base::ToLowerASCII(item.GetString()));
+      }
+    }
+  }
+
+  bool IsFontAllowed(const std::string& family) {
+    EnsureInit();
+    if (!restrict_fonts) return true;  // no restriction — pass through
+    return allowed_fonts.count(base::ToLowerASCII(family)) > 0;
+  }
+} // namespace fwys_fonts

