+// FWYS: Override Sec-CH-UA headers in outgoing requests
+// Called whenever Chromium adds CH headers to a request
+void FwysOverrideClientHintHeaders(net::HttpRequestHeaders* headers) {
+  fwys_ua_data::EnsureInit();
+  if (!fwys_ua_data::IsEnabled()) return;
+
+  // Build Sec-CH-UA header value: "Not?A_Brand";v="99", "Chromium";v="131", ...
+  std::string sec_ch_ua;
+  for (size_t i = 0; i < fwys_ua_data::brands.size(); ++i) {
+    if (i > 0) sec_ch_ua += ", ";
+    sec_ch_ua += "\"" + fwys_ua_data::brands[i].brand + "\"";
+    sec_ch_ua += ";v=\"" + fwys_ua_data::brands[i].version + "\"";
+  }
+
+  headers->SetHeader("Sec-CH-UA",                  sec_ch_ua);
+  headers->SetHeader("Sec-CH-UA-Mobile",            fwys_ua_data::mobile ? "?1" : "?0");
+  headers->SetHeader("Sec-CH-UA-Platform",          "\"" + fwys_ua_data::platform + "\"");
+  headers->SetHeader("Sec-CH-UA-Platform-Version",  "\"" + fwys_ua_data::platform_version + "\"");
+  headers->SetHeader("Sec-CH-UA-Arch",              "\"" + fwys_ua_data::architecture + "\"");
+  headers->SetHeader("Sec-CH-UA-Bitness",           "\"" + fwys_ua_data::bitness + "\"");
+  headers->SetHeader("Sec-CH-UA-Wow64",             fwys_ua_data::wow64 ? "?1" : "?0");
+
+  // Full version list
+  std::string fvl;
+  for (size_t i = 0; i < fwys_ua_data::brands.size(); ++i) {
+    if (i > 0) fvl += ", ";
+    fvl += "\"" + fwys_ua_data::brands[i].brand + "\"";
+    fvl += ";v=\"" + fwys_ua_data::full_version + "\"";
+  }
+  headers->SetHeader("Sec-CH-UA-Full-Version-List", fvl);
+}
+
+// Hook this into the existing AddClientHintsHeaders function:
 void AddClientHintsHeaders(
     ClientHintsPreferences& client_hints_prefs,
     net::HttpRequestHeaders* headers,
     ...) {
   // ... existing CH header logic ...
+
+  // FWYS: Override all CH headers with profile values (after existing code)
+  FwysOverrideClientHintHeaders(headers);
 }
