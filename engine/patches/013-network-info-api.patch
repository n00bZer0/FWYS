 double NetworkInformation::downlinkMax() const {
-  return downlink_max_mbps_;
+  // FWYS: Max downlink based on connection type
+  fwys_netinfo::EnsureInit();
+  if (fwys_netinfo::connection_type == "wifi") return 54.0;   // WiFi 802.11n
+  if (fwys_netinfo::connection_type == "ethernet") return 100.0; // 100Mbps ethernet
+  if (fwys_netinfo::connection_type == "4g") return 50.0;     // LTE max
+  return 10.0;
 }

