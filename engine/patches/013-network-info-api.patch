+//
+// FWYS Patch 013 (NEW): Network Information API spoofing
+// navigator.connection — type, effectiveType, downlink, rtt, saveData
+// Residential IPs should show wifi/4g, not fiber/ethernet

 #include "third_party/blink/renderer/modules/network_information/network_information.h"
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"

+// ─── FWYS Network Info namespace ─────────────────────────────────────────────
+namespace fwys_netinfo {
+
+  // Connection types that match real browser behavior
+  // Sites check these to verify the connection type matches the IP type
+  static std::string connection_type      = "wifi";
+  static std::string effective_type       = "4g";
+  static double downlink                  = 0.0;  // 0 = uninitialized
+  static uint32_t rtt                     = 0;    // 0 = uninitialized
+  static bool save_data                   = false;
+  static bool initialized                 = false;
+
+  void EnsureInit() {
+    if (initialized) return;
+    initialized = true;
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+
+    if (cmd->HasSwitch("fwys-net-type"))
+      connection_type = cmd->GetSwitchValueASCII("fwys-net-type");
+    if (cmd->HasSwitch("fwys-net-effective-type"))
+      effective_type = cmd->GetSwitchValueASCII("fwys-net-effective-type");
+    if (cmd->HasSwitch("fwys-net-downlink"))
+      base::StringToDouble(cmd->GetSwitchValueASCII("fwys-net-downlink"), &downlink);
+    if (cmd->HasSwitch("fwys-net-rtt"))
+      base::StringToUint(cmd->GetSwitchValueASCII("fwys-net-rtt"), &rtt);
+
+    // Derive realistic defaults from seed if no explicit values
+    if (downlink == 0.0 || rtt == 0) {
+      uint64_t seed = 0;
+      if (cmd->HasSwitch("fwys-canvas-seed"))
+        base::StringToUint64(cmd->GetSwitchValueASCII("fwys-canvas-seed"), &seed);
+
+      if (seed != 0) {
+        uint64_t h = seed ^ 0xc0ffeedeadbeefULL;
+        h ^= h >> 33; h *= 0xff51afd7ed558ccdULL; h ^= h >> 33;
+
+        if (connection_type == "wifi" || connection_type == "4g") {
+          // WiFi: 5-150 Mbps downlink, 20-80ms RTT
+          downlink = 5.0 + ((double)(h & 0xFF) / (double)0xFF) * 145.0;
+          downlink = std::round(downlink * 100.0) / 100.0;  // 2 decimal places
+          rtt = 20 + (uint32_t)((h >> 8) & 0x3F);  // 20-84ms
+        } else if (connection_type == "ethernet") {
+          // Ethernet: 50-1000 Mbps, 1-10ms RTT
+          downlink = 50.0 + ((double)(h & 0xFF) / (double)0xFF) * 950.0;
+          rtt = 1 + (uint32_t)((h >> 8) & 0xF);
+        } else {
+          // 4g/cellular: 1-50 Mbps, 50-300ms RTT
+          downlink = 1.0 + ((double)(h & 0xFF) / (double)0xFF) * 49.0;
+          rtt = 50 + (uint32_t)((h >> 8) & 0xFF);
+        }
+      } else {
+        // Safe fallback: average WiFi
+        downlink = 10.0;
+        rtt = 50;
+      }
+    }
+  }
+
+  bool IsEnabled() { EnsureInit(); return true; }
+
+} // namespace fwys_netinfo

